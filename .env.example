# Example environment configuration
# Copy this file to .env and update with your values

# GitHub Configuration
GITHUB_TOKEN=your_github_token_here
REPO_URL=https://github.com/yourusername/modbus.git

# Raspberry Pi Configuration
PI_USER=pi
PI_PASSWORD=your_pi_password_here
PI_HOST=192.168.20.228
APP_DIR=modbus

# Serial Port Configuration
SERIAL_PORT=/dev/ttyUSB0
BAUD_RATE=9600
DATA_BITS=8
STOP_BITS=1
PARITY=none

# Modbus Configuration
MODBUS_SLAVE_ID=1
MODBUS_TIMEOUT=1000
MODBUS_RETRIES=3

# Reading Configuration
REGISTER_ADDRESS=0
REGISTER_COUNT=10
POLLING_INTERVAL=5000

# Application Configuration
NODE_ENV=production
TZ=Asia/Bangkok

# MQTT Configuration
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=your_mqtt_username
MQTT_PASSWORD=your_mqtt_password
MQTT_CLIENT_ID=
MQTT_BASE_TOPIC=modbus/meter
MQTT_QOS=0
MQTT_RETAIN=false
MQTT_CONNECT_TIMEOUT=30000
MQTT_RECONNECT_PERIOD=1000
MQTT_KEEPALIVE=60

# Auto-Start Configuration (NEW FEATURE)
# Set to 'false' to disable automatic MQTT polling on server start
AUTO_START_ENABLED=true
# Comma-separated list of input register addresses to read automatically
AUTO_START_REGISTERS=300,301,302,311,312,313,316,317,406,604,605,606,610,611,612
# Polling interval in milliseconds (how often to read and publish)
AUTO_START_INTERVAL=5000
# Device identifier for MQTT topics
AUTO_START_DEVICE_ID=device-1
# Data type to read: coils, input, holding, both
AUTO_START_TYPE=input
